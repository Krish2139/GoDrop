# ==========================================
# RideFlow Global Environment Variables
# ==========================================

NODE_ENV=development

# Ports
GATEWAY_PORT=5000
RIDE_SERVICE_PORT=5001
DRIVER_SERVICE_PORT=5002
FRONTEND_PORT=3000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rideflow_db
POSTGRES_USER=rideflow_user
POSTGRES_PASSWORD=rideflow_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_rideflow_academic_system_design_2026
JWT_EXPIRES_IN=24h

# Service URLs (for Gateway and Inter-service communication)
RIDE_SERVICE_URL=http://localhost:5001
DRIVER_SERVICE_URL=http://localhost:5002

# Frontend Environment
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
