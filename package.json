{
  "name": "rideflow-distributed-system",
  "version": "1.0.0",
  "type": "module",
  "description": "Distributed Ride Booking and Driver Dispatch System",
  "private": true,
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "gateway:dev": "npm --prefix gateway run dev",
    "ride:dev": "npm --prefix services/ride-service run dev",
    "driver:dev": "npm --prefix services/driver-service run dev",
    "db:test": "node database/test-connection.js",
    "db:migrate": "node database/migrate.js up",
    "db:seed": "node database/migrate.js seed",
    "docker:db": "docker compose up -d postgres",
    "docker:all": "docker compose up -d",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "keywords": [
    "distributed-systems",
    "ride-dispatch",
    "microservices",
    "redis",
    "rabbitmq",
    "postgresql",
    "docker"
  ],
  "author": "RideFlow Academic Team",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.3.1",
    "ioredis": "^6.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
